data: {"result":{"content":[{"type":"text","text":"{\n  \u0022user_id\u0022: 28291918,\n  \u0022display_name\u0022: \u0022Oikantik Basu\u0022,\n  \u0022country\u0022: \u0022\u0022,\n  \u0022region\u0022: \u0022\u0022,\n  \u0022city\u0022: \u0022\u0022,\n  \u0022git_hub_user_name\u0022: \u0022\u0022,\n  \u0022twitter_user_name\u0022: \u0022\u0022,\n  \u0022linked_in_url\u0022: \u0022\u0022,\n  \u0022website_url\u0022: \u0022\u0022,\n  \u0022occupation\u0022: \u0022\u0022,\n  \u0022organization\u0022: \u0022\u0022,\n  \u0022bio\u0022: \u0022\u0022,\n  \u0022user_last_active\u0022: \u00222026-09-25T20:49:04.020Z\u0022,\n  \u0022user_join_date\u0022: \u00222025-08-10T10:06:38.253Z\u0022,\n  \u0022performance_tier\u0022: \u0022CONTRIBUTOR\u0022,\n  \u0022performance_tier_category\u0022: \u0022USER_ACHIEVEMENT_TYPE_COMPETITIONS\u0022,\n  \u0022user_avatar_url\u0022: \u0022https://storage.googleapis.com/kaggle-avatars/images/28291918-kg.png?t=2025-11-30-20-59-25\u0022,\n  \u0022achievement_summaries\u0022: [\n    {\n      \u0022tier\u0022: \u0022CONTRIBUTOR\u0022,\n      \u0022summary_type\u0022: \u0022USER_ACHIEVEMENT_TYPE_COMPETITIONS\u0022,\n      \u0022rank_out_of\u0022: 217542\n    },\n    {\n      \u0022tier\u0022: \u0022CONTRIBUTOR\u0022,\n      \u0022summary_type\u0022: \u0022USER_ACHIEVEMENT_TYPE_DATASETS\u0022,\n      \u0022rank_out_of\u0022: 11794\n    },\n    {\n      \u0022tier\u0022: \u0022CONTRIBUTOR\u0022,\n      \u0022summary_type\u0022: \u0022USER_ACHIEVEMENT_TYPE_NOTEBOOKS\u0022,\n      \u0022rank_out_of\u0022: 60651\n    }\n  ],\n  \u0022total_users_i_follow\u0022: 1,\n  \u0022user_name\u0022: \u0022oikantikbasu007\u0022,\n  \u0022tagline\u0022: \u0022\u0022,\n  \u0022pronouns\u0022: \u0022\u0022,\n  \u0022total_competitions\u0022: 1,\n  \u0022total_discussions\u0022: 1,\n  \u0022badges\u0022: [\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 49,\n        \u0022name\u0022: \u00221 Year on Kaggle\u0022,\n        \u0022description\u0022: \u0022Active on Kaggle for more than 1 year.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2F163e0f27360ae958da99dde2a68f7e00%2FBadge-46.svg?generation=1727468408101916\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 7112374\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222026-09-20T14:43:38.903130200Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 5,\n        \u0022name\u0022: \u0022Competitor\u0022,\n        \u0022description\u0022: \u0022Made a submission to a Kaggle competition that is eligible for points or medals. These competitions are full-scale machine learning challenges which pose difficult real world prediction problems.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2Fb05e17f63f2eead904a1f04d05bb51a6%2FBadge.svg?generation=1727458564383731\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 295368\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222026-03-17T19:36:19.860172700Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 7,\n        \u0022name\u0022: \u0022Research Competitor\u0022,\n        \u0022description\u0022: \u0022Made a submission to a Research competition. Research competitions feature problems which are more experimental, may not have a clean or easy solution, and which are integral to a specific domain.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2F33a465e5bfb87721b4d97d899c717eb4%2FBadge-3.svg?generation=1727462497490072\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 106809\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222026-09-24T07:24:33.144273400Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 12,\n        \u0022name\u0022: \u0022March Mania Competitor\u0022,\n        \u0022description\u0022: \u0022Made a submission to a March Mania competition. This unique competition series challenges competitors to predict the winners of each years\u0027 NCAA basketball tournament.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2F41ff6ec1c3a3ada0ae1595df7e1a18fd%2FBadge-7.svg?generation=1727462713945054\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 7770\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222026-03-17T19:57:19.959379Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 13,\n        \u0022name\u0022: \u0022Code Submitter\u0022,\n        \u0022description\u0022: \u0022Made a submission to a code competition. These competitions require the submission of a reproducible bundle of code rather than a simple file of predictions.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2F08aa345b8928ae96e21ee3586021500e%2FBadge-8.svg?generation=1727462754402917\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 176672\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222026-09-24T07:42:32.697956400Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 30,\n        \u0022name\u0022: \u0022Python Coder\u0022,\n        \u0022description\u0022: \u0022Created a python notebook. Python is one of the most popular general purpose programming languages and has gained widespread use in the machine learning community.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2F09e1f99bdf3222934ad7769409ec3f6d%2FBadge-26.svg?generation=1727468059623106\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 8939267\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222026-01-10T05:31:43.422051700Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 33,\n        \u0022name\u0022: \u0022Code Uploader\u0022,\n        \u0022description\u0022: \u0022Uploaded a notebook. With the import feature you can upload notebook files to Kaggle. This allows you to work on your local machine and upload your work when you are ready to share or submit it.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2F1e4546d427340e1495b9ee02261e2dc6%2FBadge-34.svg?generation=1727468126171650\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 1002785\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222026-01-10T04:40:42.540470200Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 34,\n        \u0022name\u0022: \u0022API Notebook Creator\u0022,\n        \u0022description\u0022: \u0022Imported a notebook using the Kaggle API. Use the Kaggle API for convenience or as part of an automated workflow.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2F4320b13590f043b8c58421eb25f04235%2FBadge-33.svg?generation=1727468143701354\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 61678\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222026-09-24T10:45:40.213027400Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 36,\n        \u0022name\u0022: \u0022Colab Coder\u0022,\n        \u0022description\u0022: \u0022Imported a notebook from Colab or opened a notebook in Colab. You can easily import notebooks from Colab (to share or submit on Kaggle). Likewise you can open any Kaggle notebook in Colab to edit.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2F42167cf9c1c0a74d4e1c7503c010c82d%2FBadge-31.svg?generation=1727468175250681\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 87793\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222026-09-24T07:51:31.995674200Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 38,\n        \u0022name\u0022: \u0022Code Forker\u0022,\n        \u0022description\u0022: \u0022Copied a notebook and made changes to it. Copying a notebook (also known as \u0027forking\u0027 a notebook) is a great way to save time, allowing you to quickly build on top of publicly shared work.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2F7567026dd0c594f1193b49a98a976056%2FBadge-35.svg?generation=1727468213893504\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 1061341\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222026-09-23T23:57:27.258763100Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 39,\n        \u0022name\u0022: \u0022Notebook Modeler\u0022,\n        \u0022description\u0022: \u0022Used a model in a notebook. Pretrained models from the Kaggle Model Hub are powerful tools for taking your work to the next level.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2F2df508502fba7fc8937f3847e46b8ec4%2FBadge-29.svg?generation=1727468233931525\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 348861\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222026-03-17T18:18:20.310297800Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 17,\n        \u0022name\u0022: \u0022Dataset Creator\u0022,\n        \u0022description\u0022: \u0022Created a dataset. It\u2019s easy to create a dataset on Kaggle and doing so is a great way to start a data science portfolio, share reproducible research, or work with collaborators on a project.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2F28e0e70842ce6972f4d68f5b6ecd549a%2FBadge-12.svg?generation=1727462988946700\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 1765271\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222026-04-21T16:53:47.088555100Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 20,\n        \u0022name\u0022: \u0022API Dataset Creator\u0022,\n        \u0022description\u0022: \u0022Created a dataset using the Kaggle API. Use the Kaggle API for convenience or as part of an automated workflow.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2F4bcf6474cdf3503864419523d22b6019%2FBadge-15.svg?generation=1727463114221819\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 54947\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222026-09-25T09:08:56.859919Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 29,\n        \u0022name\u0022: \u0022Competition Modeler\u0022,\n        \u0022description\u0022: \u0022Used a model in a competition notebook. Pretrained models are powerful tools for taking your competition submissions to the next level.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2Feb028e2f7e6b3e2bef2b3682f6919224%2FBadge-25.svg?generation=1727468044501552\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 110018\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222026-03-17T18:48:21.691172300Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 101,\n        \u0022name\u0022: \u0022Kaggle Community Member\u0022,\n        \u0022description\u0022: \u0022Joined the Kaggle Community by creating an account. The first step in a great adventure!\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F10489106%2F8235ef48b7e37d36d6e081d112f303de%2FBadge-62.svg?generation=1758039755687969\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 33954463\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222025-12-20T15:48:35.247145800Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 45,\n        \u0022name\u0022: \u0022Agent of Discord\u0022,\n        \u0022description\u0022: \u0022Joined the Kaggle Discord and linked your account. Discord is a popular chatroom platform that is more casual than traditional forums. You can join the Kaggle server here: discord.gg/kaggle\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2F0b96fc543a2faf02467b3dcd5833feff%2FBadge-45.svg?generation=1727468334875991\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 110403\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222025-11-10T19:38:12.757305100Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 105,\n        \u0022name\u0022: \u00225-Day AI Agents Intensive Course with Google\u0022,\n        \u0022description\u0022: \u0022Completed the 5-Day AI Agents Intensive Course 2025. Participants attended daily seminars, studied white papers, completed daily assignments, and created a capstone project about AI agents.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F10489106%2Fef135f20e49c369cebff513ac3c96eed%2F5-Day_AI_Agents_Intensive_Badge.svg?generation=1763052133996110\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 26914\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222025-12-18T15:29:49.384015400Z\u0022\n    },\n    {\n      \u0022badge\u0022: {\n        \u0022badge_id\u0022: 56,\n        \u0022name\u0022: \u00227 Day Login Streak\u0022,\n        \u0022description\u0022: \u0022Logged in to Kaggle 7 days in a row.\u0022,\n        \u0022image_url\u0022: \u0022https://www.googleapis.com/download/storage/v1/b/kaggle-user-content/o/inbox%2F1488634%2F6e139e7278fc9c33210e39baf918967f%2FBadge-53.svg?generation=1727468684057299\u0026alt=media\u0022,\n        \u0022badge_type\u0022: \u0022REGULAR\u0022,\n        \u0022issued_user_count\u0022: 836682\n      },\n      \u0022count\u0022: 1,\n      \u0022achieved_time\u0022: \u00222025-11-24T23:21:55.180021200Z\u0022\n    }\n  ],\n  \u0022visibility_settings\u0022: {},\n  \u0022total_active_competitions\u0022: 1,\n  \u0022progression_opt_out\u0022: false,\n  \u0022location_sharing_opt_out\u0022: false,\n  \u0022total_write_ups\u0022: 2\n}"}],"isError":false},"id":1,"jsonrpc":"2.0"}

